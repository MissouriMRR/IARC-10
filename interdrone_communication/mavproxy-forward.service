[Unit]
Description=MAVProxy MAVLink Forwarder
After=network.target

[Service]
# MAVProxy owns the FC serial port now, so the wait-for-serial guard belongs here rather
# than in drone-flight.service. If it never appears, TimeoutStartSec kills us and we retry.
ExecStartPre=/bin/bash -c 'until [ -e /dev/serial0 ]; do sleep 1; done'
ExecStart=/usr/local/bin/mavproxy_start.sh
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target