[Unit]
Description=IARC-10 Drone Flight (MAVProxy + flight code)
# Wants, not Requires: if the mesh fails to come up the drone should still fly, it just
# won't have interdrone comms or telemetry to the BATMAN VM.
After=network.target batman-net.service
Wants=batman-net.service
# The old standalone forwarder would hold the FC serial port and starve MAVProxy here.
Conflicts=mavproxy-forward.service

[Service]
Type=simple
# %H is the hostname (mrrdt-#), so this unit is the same file on every Pi. systemd does not
# strip inline comments, so keep them on their own lines -- a trailing comment becomes part
# of the value.
WorkingDirectory=/home/%H/IARC-10
# --no-sync (in drone_flight_start.sh) runs the existing .venv as-is. Without it uv re-syncs
# on every start, and the direct-URL dronekit wheel needs a network fetch to generate
# metadata -- which fails with no wifi. UV_OFFLINE makes any remaining network attempt fail
# fast instead of hanging on DNS. Requires .venv to already exist: run `uv sync` once, on
# wifi, as the login user.
Environment=UV_OFFLINE=1
# Per-Pi overrides (MAVLINK_FORWARD=0, GCS_RELAY_IP, FC_MASTER, ...). Optional.
EnvironmentFile=-/etc/default/drone-flight
ExecStartPre=/bin/bash -c 'until [ -e /dev/serial0 ]; do sleep 1; done'
ExecStart=/usr/local/bin/drone_flight_start.sh
# Default KillMode=control-group: stop/restart reaps MAVProxy and the flight code together.
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
