[Unit]
Description=IARC-10 Drone Flight
After=batman-mesh.service mavproxy-forward.service
Requires=batman-mesh.service mavproxy-forward.service

[Service]
Type=simple
# Edit the repo path and the -i drone index per Pi. systemd does not strip inline
# comments, so keep them on their own lines -- a trailing comment becomes part of the value.
WorkingDirectory=/home/mrrdt-1/IARC-10
# --no-sync runs the existing .venv as-is. Without it uv re-syncs on every start, and the
# direct-URL dronekit wheel needs a network fetch to generate metadata -- which fails with
# no wifi. UV_OFFLINE makes any remaining network attempt fail fast instead of hanging on
# DNS. Requires .venv to already exist: run `uv sync` once, on wifi, as the login user.
Environment=UV_OFFLINE=1
ExecStartPre=/bin/bash -c 'until [ -e /dev/serial0 ]; do sleep 1; done'
ExecStart=/usr/local/bin/uv run --no-sync run.py -i 1
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target